{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nightmare-eval/run-manifest.schema.json",
  "title": "Private per-response run manifest",
  "description": "Store privately. Never include credentials, source pattern text, or rubric contents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign", "batch", "split", "fixture", "replicate", "created_at", "hashes", "model", "settings", "response", "transport_retries"],
  "properties": {
    "campaign": {"type": "string", "minLength": 1},
    "batch": {"type": "string", "minLength": 1},
    "split": {"enum": ["development", "holdout"]},
    "fixture": {"type": "string", "minLength": 1},
    "replicate": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "canonical_input_sha256", "solver_prompt_sha256", "client_profile_sha256", "rubric_sha256"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_input_sha256": {"$ref": "#/$defs/sha256"},
        "solver_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "client_profile_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_label", "pinned_profile", "requested_model", "returned_model"],
      "properties": {
        "provider_label": {"type": "string", "minLength": 1},
        "pinned_profile": {"type": "string", "minLength": 1},
        "requested_model": {"type": "string", "minLength": 1},
        "returned_model": {"type": "string", "minLength": 1}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "top_p", "max_output_tokens", "seed", "seed_supported"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "seed": {"type": ["integer", "null"]},
        "seed_supported": {"type": "boolean"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "finish_reason", "input_tokens", "output_tokens", "status"],
      "properties": {
        "request_id": {"type": ["string", "null"]},
        "finish_reason": {"type": ["string", "null"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["valid", "invalid_json", "schema_failure", "truncated", "refusal", "provider_error", "route_mismatch"]}
      }
    },
    "transport_retries": {"type": "integer", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
  }
}
