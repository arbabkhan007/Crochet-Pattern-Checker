{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nightmare-eval/rubric.schema.json",
  "title": "Private Nightmare Pattern Verifier rubric",
  "description": "Schema only. The rubric instance is answer-bearing and must remain outside the public repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture", "version", "category_weights", "false_positive_penalty", "items"],
  "properties": {
    "fixture": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "category_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["math", "coherence", "finishing", "absurdity"],
      "properties": {
        "math": {"type": "integer", "minimum": 0},
        "coherence": {"type": "integer", "minimum": 0},
        "finishing": {"type": "integer", "minimum": 0},
        "absurdity": {"type": "integer", "minimum": 0}
      }
    },
    "false_positive_penalty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_refuted_claim", "cap"],
      "properties": {
        "per_refuted_claim": {"type": "integer", "minimum": 0},
        "cap": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "location", "expected_claim", "required_evidence", "points", "acceptable_variants", "partial_credit"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["math", "coherence", "finishing", "absurdity"]},
          "location": {"type": "string", "minLength": 1},
          "expected_claim": {"type": "string", "minLength": 1},
          "required_evidence": {"type": "string", "minLength": 1},
          "points": {"type": "integer", "minimum": 1, "maximum": 100},
          "acceptable_variants": {
            "type": "array",
            "items": {"type": "string"}
          },
          "partial_credit": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "points", "criteria"],
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "points": {"type": "integer", "minimum": 0, "maximum": 100},
                "criteria": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
