{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:novality:schema:ns01-pdf-render-model:v1",
  "title": "NS 01 compiled PDF render model",
  "description": "Transient, validated data compiled from patterns/01_Hamish_the_Highland_Cow.md. The Markdown master remains the sole authoring source; do not edit a second copy of pattern instructions in JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "pattern", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "patterns/01_Hamish_the_Highland_Cow.md" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_code", "title", "subtitle", "skill_level", "terminology",
        "time_hours", "finished_size_cm", "finished_size_approximate", "hook_mm", "hook_us",
        "yarn_weight", "gauge", "yarns"
      ],
      "properties": {
        "design_code": { "const": "NS 01" },
        "title": { "const": "Hamish" },
        "subtitle": { "const": "the Highland Cow" },
        "skill_level": { "type": "string", "minLength": 1 },
        "terminology": { "const": "US" },
        "time_hours": { "$ref": "#/$defs/time_hours" },
        "finished_size_cm": { "type": "number", "exclusiveMinimum": 0 },
        "finished_size_approximate": { "const": true },
        "hook_mm": { "type": "number", "exclusiveMinimum": 0 },
        "hook_us": { "type": "string", "minLength": 1 },
        "yarn_weight": { "type": "string", "minLength": 1 },
        "gauge": { "$ref": "#/$defs/gauge" },
        "yarns": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/yarn" }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "body"],
      "properties": {
        "head": { "$ref": "#/$defs/head" },
        "body": { "$ref": "#/$defs/body" }
      }
    }
  },
  "$defs": {
    "time_hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 1 }
      }
    },
    "gauge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stitches", "stitch_type", "rounds", "measure_cm"],
      "properties": {
        "stitches": { "type": "integer", "minimum": 1 },
        "stitch_type": { "const": "sc" },
        "rounds": { "type": "integer", "minimum": 1 },
        "measure_cm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "yarn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "grams"],
      "properties": {
        "id": { "enum": ["A", "B", "C", "D"] },
        "name": { "type": "string", "minLength": 1 },
        "grams": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "round_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "stitches"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 },
        "stitches": { "type": "integer", "minimum": 1 }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "rounds", "closure", "neck_join", "features"],
      "properties": {
        "direction": { "const": "TOP_DOWN" },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/round_row" }
        },
        "closure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["round", "stitches", "closed"],
          "properties": {
            "round": { "type": "integer", "minimum": 1 },
            "stitches": { "type": "integer", "minimum": 0 },
            "closed": { "const": true }
          }
        },
        "neck_join": {
          "type": "object",
          "additionalProperties": false,
          "required": ["round", "stitches"],
          "properties": {
            "round": { "type": "integer", "minimum": 1 },
            "stitches": { "type": "integer", "minimum": 1 }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eyes", "muzzle", "horns", "ears", "fringe"],
          "properties": {
            "eyes": { "$ref": "#/$defs/eye_placement" },
            "muzzle": { "$ref": "#/$defs/muzzle_placement" },
            "horns": { "$ref": "#/$defs/spaced_feature" },
            "ears": { "$ref": "#/$defs/round_span" },
            "fringe": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rounds"],
              "properties": {
                "rounds": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "rounds", "ending", "features"],
      "properties": {
        "direction": { "const": "BOTTOM_UP" },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/round_row" }
        },
        "ending": {
          "type": "object",
          "additionalProperties": false,
          "required": ["round", "stitches", "open"],
          "properties": {
            "round": { "type": "integer", "minimum": 1 },
            "stitches": { "type": "integer", "minimum": 1 },
            "open": { "const": true }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["front_legs", "back_legs", "belly_patch", "tail"],
          "properties": {
            "front_legs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["round_start", "round_end", "gap_stitches"],
              "properties": {
                "round_start": { "type": "integer", "minimum": 1 },
                "round_end": { "type": "integer", "minimum": 1 },
                "gap_stitches": { "type": "integer", "minimum": 1 }
              }
            },
            "back_legs": { "$ref": "#/$defs/round_span" },
            "belly_patch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["optional", "lower_edge_offset_from_base_rounds"],
              "properties": {
                "optional": { "const": true },
                "lower_edge_offset_from_base_rounds": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "tail": {
              "type": "object",
              "additionalProperties": false,
              "required": ["anchor_note"],
              "properties": {
                "anchor_note": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "round_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_start", "round_end"],
      "properties": {
        "round_start": { "type": "integer", "minimum": 1 },
        "round_end": { "type": "integer", "minimum": 1 }
      }
    },
    "muzzle_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_start", "lower_edge_round_start", "lower_edge_round_end"],
      "properties": {
        "round_start": { "type": "integer", "minimum": 1 },
        "lower_edge_round_start": { "type": "integer", "minimum": 1 },
        "lower_edge_round_end": { "type": "integer", "minimum": 1 }
      }
    },
    "eye_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diameter_mm", "round_start", "round_end", "spacing_stitches"],
      "properties": {
        "diameter_mm": { "type": "number", "exclusiveMinimum": 0 },
        "round_start": { "type": "integer", "minimum": 1 },
        "round_end": { "type": "integer", "minimum": 1 },
        "spacing_stitches": { "type": "integer", "minimum": 1 }
      }
    },
    "spaced_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_start", "round_end", "spacing_stitches"],
      "properties": {
        "round_start": { "type": "integer", "minimum": 1 },
        "round_end": { "type": "integer", "minimum": 1 },
        "spacing_stitches": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
