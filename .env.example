# Optional hosted multi-model review. This is disabled unless providers are explicitly selected.
# The normal deterministic checker never makes provider calls.
# Uncomment a provider selection only after setting its real API key and model below.
# CROCHET_CONSENSUS_PROVIDERS=openai,anthropic
# If omitted, every selected provider is required. Use a subset only when partial
# participation is an intentional policy choice.
# CROCHET_REQUIRED_PROVIDERS=openai,anthropic

# Provider credentials and explicit model IDs (server-side only).
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
# Providers requiring a custom endpoint:
# META_LLAMA uses LLAMA_API_KEY, LLAMA_MODEL, and LLAMA_BASE_URL.
# QWEN uses QWEN_API_KEY, QWEN_MODEL, and QWEN_BASE_URL.
# openai_compatible uses CROCHET_COMPAT_API_KEY (optional), CROCHET_COMPAT_MODEL,
# and CROCHET_COMPAT_BASE_URL.

# Specialist roles are assigned in selected-provider order unless overridden.
# Available built-in roles: stitch_arithmetic, construction_assembly,
# instruction_clarity, materials_completeness, adversarial_counterexample.
# CROCHET_ROLE_OPENAI=stitch_arithmetic
# CROCHET_ROLE_ANTHROPIC=construction_assembly

# Consensus policy and bounded parallelism.
CROCHET_CONSENSUS_MIN_MODELS=2
CROCHET_CONSENSUS_MIN_PARTICIPATION_RATIO=1.0
CROCHET_CONSENSUS_THRESHOLD=0.67
CROCHET_CONSENSUS_MAX_CONCURRENCY=8
CROCHET_CONSENSUS_CROSS_EXAMINATION=true
CROCHET_CONSENSUS_ADVERSARIAL_REVIEW=true
CROCHET_CONSENSUS_STRICT_PARTICIPATION=true
CROCHET_REQUIRED_REVIEW_ROLES=stitch_arithmetic,construction_assembly
CROCHET_PROVIDER_TIMEOUT_SECONDS=45
CROCHET_PROVIDER_MAX_RETRIES=2
CROCHET_PROVIDER_MAX_TOKENS=1800

# Optional fallback example. The fallback runs only if its selected primary fails.
# CROCHET_FALLBACK_MAP=openai=deepseek

# Local SQLite run/report history. Protect this file; it contains submitted patterns.
CROCHET_CONSENSUS_DATABASE=.crochet_consensus/history.sqlite3
CROCHET_AI_CACHE=.crochet_cache/ai
