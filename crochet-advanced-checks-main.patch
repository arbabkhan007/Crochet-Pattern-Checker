index 0000000000000000000000000000000000000000..4887a9adcb18c1f867f349e418cf3ac39898436b
--- /dev/null
+++ b/src/crochet_checker/validation/advanced_checks/inserts.py
@@ -0,0 +1,128 @@
+"""Explicit insert-diameter and flattened-tube closure checks."""
+
+from __future__ import annotations
+
+import math
+import re
+
+from .common import AdvancedFinding, ROUND_HEADER, STATED_COUNT, split_sections
+from .spatial import _gauge_cm
+
+
+def check_insert_diameter(
+    insert_diameter_cm: float,
+    opening_stitches: int,
+    gauge_stitches_per_cm: float,
+) -> AdvancedFinding | None:
+    """Compare an explicit rigid insert and opening using an explicit gauge.
+
+    This is an idealized circumference-to-diameter estimate, not a stretch or
+    fit guarantee. The result is therefore a warning to verify the materials.
+    """
+    if insert_diameter_cm <= 0 or opening_stitches <= 0 or gauge_stitches_per_cm <= 0:
+        return None
+    opening_diameter_cm = opening_stitches / (gauge_stitches_per_cm * math.pi)
+    if insert_diameter_cm <= opening_diameter_cm:
+        return None
+    required = math.ceil(insert_diameter_cm * math.pi * gauge_stitches_per_cm)
+    return AdvancedFinding(
+        "InsertDiameterOverflow",
+        f"A {insert_diameter_cm:g} cm insert exceeds the estimated {opening_diameter_cm:.2f} cm opening at the stated gauge; about {required} stitches would be needed around its circumference. Verify the fit and gauge.",
+        "warning",
+    )
+
+
+def check_folded_tube_closure(
+    tube_stitches: int, closure_stitches: int
+) -> list[AdvancedFinding]:
+    """Compare explicit closing stitches with a two-layer flattened tube."""
+    if tube_stitches <= 0 or closure_stitches < 0:
+        return []
+    expected = (tube_stitches + 1) // 2
+    if closure_stitches < expected:
+        joins_left = expected - closure_stitches
+        return [
+            AdvancedFinding(
+                "PartialTubeClosure",
+                f"A {tube_stitches}-stitch tube typically needs about {expected} joining stitches when flattened, but only {closure_stitches} are written; approximately {joins_left} joins may remain unclosed. Verify the intended closure method.",
+                "warning",
+            )
+        ]
+    if closure_stitches > expected:
+        return [
+            AdvancedFinding(
+                "FoldedTubeClosureMismatch",
+                f"The written closure uses {closure_stitches} stitches for a {tube_stitches}-stitch tube; the simple two-layer estimate is {expected}. Verify the closure construction.",
+                "warning",
+            )
+        ]
+    return []
+
+
+_INSERT = re.compile(
+    r"\b(\d+(?:\.\d+)?)\s*cm\s+(dowel|rod|core|ring|disc|disk|tube)\b"
+    r"[^.\n]{0,80}?\b(?:inside|in)\b[^.\n]{0,50}?"
+    r"(?:opening\s+of\s+|opening\s*[:=]\s*|)(\d+)\s*[- ]?stitch(?:es)?\b",
+    re.IGNORECASE,
+)
+_CLOSURE = re.compile(
+    r"\bflatten(?:ed|ing)?\b[^.\n]{0,70}?\b(?:close|sew|cinch|graft|seam)\w*\b"
+    r"[^.\n]{0,50}?\b(\d+)\s+(?:sc|single\s+crochet)\b",
+    re.IGNORECASE,
+)
+
+
+def insert_findings(text: str) -> list[AdvancedFinding]:
+    findings: list[AdvancedFinding] = []
+    gauge = _gauge_cm(text)
+    for line_number, line in enumerate(text.splitlines(), start=1):
+        match = _INSERT.search(line)
+        if match and gauge:
+            item = check_insert_diameter(
+                float(match.group(1)),
+                int(match.group(3)),
+                gauge[0],
+            )
+            if item:
+                findings.append(
+                    AdvancedFinding(item.code, item.message, item.severity, line_number)
+                )
+
+    for _heading, body, start_line in split_sections(text):
+        counts: list[tuple[int, int, int]] = []
+        body_start = start_line + (1 if _heading else 0)
+        for local_index, line in enumerate(body.splitlines()):
+            header = ROUND_HEADER.match(line.strip())
+            stated = STATED_COUNT.search(line.strip())
+            if header and stated:
+                counts.append(
+                    (
+                        int(header.group(1)),
+                        int(stated.group(1)),
+                        body_start + local_index,
+                    )
+                )
+        if not counts:
+            continue
+        for local_index, line in enumerate(body.splitlines()):
+            if not re.search(r"\bflatten(?:ed|ing)?\b", line, re.IGNORECASE):
+                continue
+            closure = _CLOSURE.search(line)
+            if not closure:
+                continue
+            closing_count = int(closure.group(1))
+            line_number = body_start + local_index
+            preceding = [record for record in counts if record[2] <= line_number]
+            if not preceding:
+                continue
+            tube_count = preceding[-1][1]
+            for finding in check_folded_tube_closure(tube_count, closing_count):
+                findings.append(
+                    AdvancedFinding(
+                        finding.code,
+                        finding.message,
+                        finding.severity,
+                        line_number,
+                    )
+                )
+    return findings
diff --git a/src/crochet_checker/validation/advanced_checks/loop_occupancy.py b/src/crochet_checker/validation/advanced_checks/loop_occupancy.py
new file mode 100644
index 0000000000000000000000000000000000000000..58a39325e4926b226d44e04dd73502e452743f75
--- /dev/null
+++ b/src/crochet_checker/validation/advanced_checks/loop_occupancy.py
@@ -0,0 +1,170 @@
+"""Stateful FLO/BLO occupancy and explicit hoof/sole crease alignment."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Mapping
+
+from .common import AdvancedFinding, ROUND_HEADER, split_sections
+
+
+@dataclass(frozen=True)
+class RoundLoopState:
+    round_number: int
+    flo_free: bool | None
+    blo_free: bool | None
+    established_by_round: int | None = None
+
+
+def build_loop_states(round_modes: Mapping[int, str]) -> dict[int, RoundLoopState]:
+    """Build previous-round loop banks from each round's written loop mode.
+
+    ``BLO`` consumes the prior round's BLO and leaves its FLO free; ``FLO``
+    does the converse. ``BOTH`` consumes both. A missing/ambiguous next-round
+    mode stays unknown.
+    """
+    states: dict[int, RoundLoopState] = {}
+    for number in sorted(round_modes):
+        next_number = number + 1
+        mode = round_modes.get(next_number, "UNKNOWN").upper()
+        if mode == "BLO":
+            flo_free, blo_free = True, False
+        elif mode == "FLO":
+            flo_free, blo_free = False, True
+        elif mode == "BOTH":
+            flo_free, blo_free = False, False
+        else:
+            flo_free, blo_free = None, None
+        states[number] = RoundLoopState(
+            number,
+            flo_free,
+            blo_free,
+            next_number if mode in {"BLO", "FLO", "BOTH"} else None,
+        )
+    return states
+
+
+def check_surface_loop_join(
+    target_round: int,
+    requested_loop: str,
+    states: Mapping[int, RoundLoopState],
+) -> str | None:
+    """Return a collision message only when the requested bank is known occupied."""
+    requested = requested_loop.upper()
+    if requested not in {"FLO", "BLO"}:
+        raise ValueError("requested_loop must be 'FLO' or 'BLO'.")
+    state = states.get(target_round)
+    if state is None:
+        return None
+    free = state.flo_free if requested == "FLO" else state.blo_free
+    if free is not False:
+        return None
+    occupied_by = state.established_by_round
+    source = f"Round {occupied_by}" if occupied_by is not None else "a later round"
+    remaining = "BLO" if requested == "FLO" else "FLO"
+    return (
+        f"LoopCollisionError: Round {target_round} {requested} was already "
+        f"consumed by {source}; only {remaining} remains available."
+    )
+
+
+def _mode(body: str) -> str:
+    front = bool(re.search(r"\bFLO\b|front\s+loops?\s+only", body, re.IGNORECASE))
+    back = bool(re.search(r"\bBLO\b|back\s+loops?\s+only", body, re.IGNORECASE))
+    both = bool(re.search(r"\b(?:through\s+)?both\s+loops\b", body, re.IGNORECASE))
+    if both and not (front or back):
+        return "BOTH"
+    if front and back:
+        return "UNKNOWN"
+    if front:
+        return "FLO"
+    if back:
+        return "BLO"
+    # Ordinary crochet stitches are conventionally worked through both top
+    # loops. Restrict this default to lines with an explicit stitch token.
+    if re.search(
+        r"\b(?:sc|hdc|dc|tr|dtr|inc|dec|sc2tog|dc2tog)\b", body, re.IGNORECASE
+    ):
+        return "BOTH"
+    return "UNKNOWN"
+
+
+_TARGET_LOOP = re.compile(
+    r"\b(?:join|attach|sew|work|graft|crochet|insert|use)\b"
+    r"[^.\n]{0,100}?\b(?P<loop>FLO|BLO|front\s+loops?|back\s+loops?)\b"
+    r"[^.\n]{0,55}?\b(?:of|from|in)\s+(?:round|rnd|r)\s*(?P<number>\d+)\b",
+    re.IGNORECASE,
+)
+
+
+def loop_occupancy_findings(text: str) -> list[AdvancedFinding]:
+    findings: list[AdvancedFinding] = []
+    for heading, body, section_line in split_sections(text):
+        body_start = section_line + (1 if heading else 0)
+        records: list[tuple[int, str, int]] = []
+        for local_line, line in enumerate(body.splitlines(), start=body_start):
+            header = ROUND_HEADER.match(line.strip())
+            if header:
+                records.append((int(header.group(1)), header.group(2), local_line))
+        modes = {number: _mode(body_text) for number, body_text, _ in records}
+        states = build_loop_states(modes)
+        for local_line, line in enumerate(body.splitlines(), start=body_start):
+            for match in _TARGET_LOOP.finditer(line):
+                loop = match.group("loop").upper()
+                loop = "FLO" if loop.startswith("F") else "BLO"
+                number = int(match.group("number"))
+                message = check_surface_loop_join(number, loop, states)
+                if message:
+                    findings.append(
+                        AdvancedFinding(
+                            "LoopOccupancyCollision", message, "error", local_line
+                        )
+                    )
+    findings.extend(color_crease_findings(text))
+    return findings
+
+
+_COLOR_CHANGE = re.compile(
+    r"(?:\b(?:color|colour)\s+change\b[^.\n]{0,50}?\b(?:round|rnd)\s*(\d+)\b|"
+    r"\b(?:round|rnd)\s*(\d+)\b[^.\n]{0,50}?\b(?:change|switch)\s+(?:the\s+)?(?:color|colour)\b)",
+    re.IGNORECASE,
+)
+_BLO_ROUND = re.compile(
+    r"\bBLO\b[^.\n]{0,35}?\b(?:round|rnd)\s*(\d+)\b|"
+    r"\b(?:round|rnd)\s*(\d+)\b[^.\n]{0,35}?\bBLO\b",
+    re.IGNORECASE,
+)
+
+
+def color_crease_findings(text: str) -> list[AdvancedFinding]:
+    """Flag explicit hoof/sole color changes whose BLO crease is one round off."""
+    lines = list(enumerate(text.splitlines(), start=1))
+    changes: list[tuple[int, int]] = []
+    crease_rounds: list[tuple[int, int]] = []
+    relevant = re.compile(r"\b(?:hoof|sole|shoe|boot)\b", re.IGNORECASE)
+    for number, line in lines:
+        if not relevant.search(line):
+            continue
+        change = _COLOR_CHANGE.search(line)
+        if change:
+            raw = change.group(1) or change.group(2)
+            changes.append((int(raw), number))
+        for match in _BLO_ROUND.finditer(line):
+            raw = match.group(1) or match.group(2)
+            crease_rounds.append((int(raw), number))
+    findings: list[AdvancedFinding] = []
+    for change_round, line_number in changes:
+        for crease_round, _crease_line in crease_rounds:
+            if abs(change_round - crease_round) == 1:
+                findings.append(
+                    AdvancedFinding(
+                        "ColorChangeCreaseMisalignment",
+                        f"The stated BLO sole/hoof crease is Round {crease_round}, "
+                        f"one round away from the explicit color change at Round {change_round}. "
+                        "Check whether the crease should be on the color-change round.",
+                        "warning",
+                        line_number,
+                    )
+                )
+    return findings
diff --git a/src/crochet_checker/validation/advanced_checks/oval_chain.py b/src/crochet_checker/validation/advanced_checks/oval_chain.py
new file mode 100644
index 0000000000000000000000000000000000000000..b87b38849c1869195b3d6b1b85e99d38323ee35f
--- /dev/null
+++ b/src/crochet_checker/validation/advanced_checks/oval_chain.py
@@ -0,0 +1,168 @@
+"""Foundation-chain accounting for explicit oval top/return passes."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from .common import AdvancedFinding, meaningful_lines
+
+
+@dataclass(frozen=True)
+class ChainWork:
+    """Chains consumed and stitches produced by one pass operation."""
+
+    chains_consumed: int
+    stitches_produced: int
+
+
+def validate_oval_foundation(
+    ch_count: int,
+    start_ch_from_hook: int,
+    top_ops: list[ChainWork | tuple[int, int]],
+    bottom_ops: list[ChainWork | tuple[int, int]],
+) -> tuple[list[str], int]:
+    """Validate one oval's two sides without confusing stitch production with chain use.
+
+    A multi-stitch corner operation such as ``2 sc in 2nd ch`` consumes one
+    foundation chain, not two. The top pass must cover every usable chain;
+    the return pass may use no more than ``n_available - 1`` chains.
+    """
+    if ch_count < 1 or start_ch_from_hook < 1:
+        raise ValueError("Chain count and starting-chain index must be positive.")
+    if start_ch_from_hook > ch_count:
+        raise ValueError(
+            "Starting-chain index cannot exceed the foundation-chain length."
+        )
+
+    def totals(ops: list[ChainWork | tuple[int, int]]) -> tuple[int, int]:
+        consumed = produced = 0
+        for op in ops:
+            c, s = (
+                (op.chains_consumed, op.stitches_produced)
+                if isinstance(op, ChainWork)
+                else op
+            )
+            if c < 0 or s < 0:
+                raise ValueError("Chain and stitch counts cannot be negative.")
+            consumed += int(c)
+            produced += int(s)
+        return consumed, produced
+
+    n_available = ch_count - (start_ch_from_hook - 1)
+    top_chains, top_stitches = totals(top_ops)
+    return_chains, return_stitches = totals(bottom_ops)
+    errors: list[str] = []
+
+    if top_chains != n_available:
+        errors.append(
+            f"Oval top pass consumes {top_chains} chains, but {n_available} "
+            f"are available from a chain of {ch_count} starting in chain "
+            f"{start_ch_from_hook}."
+        )
+    max_return = max(n_available - 1, 0)
+    if return_chains > max_return:
+        middle = max(n_available - 2, 0)
+        errors.append(
+            f"Oval return pass consumes {return_chains} chains, but only "
+            f"{middle} middle chains plus at most one starting-end chain "
+            f"({max_return} total) are available."
+        )
+    return errors, top_stitches + return_stitches
+
+
+_ORDINAL_CHAIN = re.compile(
+    r"(?:(\d+)(?:st|nd|rd|th)|first|last)\s+(?:foundation\s+)?(?:ch|chain)\b",
+    re.IGNORECASE,
+)
+_START_FROM_HOOK = re.compile(
+    r"(\d+)(?:st|nd|rd|th)\s+(?:foundation\s+)?(?:ch|chain)\s+from\s+(?:the\s+)?hook",
+    re.IGNORECASE,
+)
+_CHAIN_COUNT = re.compile(r"\b(?:ch|chain|chains)\s*(?:of\s*)?(\d+)\b", re.IGNORECASE)
+_RETURN_MARKER = re.compile(
+    r"\b(?:on|along|working(?:\s+on)?|continue(?:d)?)\s+(?:the\s+)?(?:opposite|other)\s+side\b|\breturn\s+pass\b",
+    re.IGNORECASE,
+)
+_STITCH_NAME = r"(?:sc|hdc|dc|tr|dtr)"
+_CHAIN_OPS = re.compile(
+    rf"(?:(?P<produced>\d+)\s+)?{_STITCH_NAME}\s+(?:in|into)\s+(?:the\s+)?"
+    rf"(?P<endpoint>(?:\d+)(?:st|nd|rd|th)|first|last)\s+(?:foundation\s+)?(?:ch|chain)\b"
+    rf"|(?:(?P<each>\d+)\s+)?{_STITCH_NAME}\s+(?:in|into)\s+(?:the\s+)?next\s+(?P<chains>\d+)\s+(?:foundation\s+)?(?:ch|chain)s?\b",
+    re.IGNORECASE,
+)
+
+
+def _pass_ops(text: str) -> list[ChainWork]:
+    result: list[ChainWork] = []
+    for match in _CHAIN_OPS.finditer(text):
+        if match.group("endpoint"):
+            result.append(ChainWork(1, int(match.group("produced") or 1)))
+        else:
+            chains = int(match.group("chains"))
+            multiplier = int(match.group("each") or 1)
+            result.append(ChainWork(chains, chains * multiplier))
+    return result
+
+
+def oval_findings(text: str) -> list[AdvancedFinding]:
+    """Read only self-contained oval instructions with explicit pass boundaries.
+
+    If the foundation count, start index, or return-side marker is absent, this
+    scanner stays silent rather than guessing how the chain is traversed.
+    """
+    findings: list[AdvancedFinding] = []
+    for line_number, raw in meaningful_lines(text):
+        if not re.search(r"\boval\b", raw, re.IGNORECASE):
+            continue
+        count_match = _CHAIN_COUNT.search(raw)
+        start_match = _START_FROM_HOOK.search(raw)
+        return_match = _RETURN_MARKER.search(raw)
+        if not count_match or not start_match or not return_match:
+            continue
+        top_ops = _pass_ops(raw[: return_match.start()])
+        return_ops = _pass_ops(raw[return_match.end() :])
+        if not top_ops or not return_ops:
+            continue
+        try:
+            errors, _total = validate_oval_foundation(
+                int(count_match.group(1)),
+                int(start_match.group(1)),
+                top_ops,
+                return_ops,
+            )
+        except ValueError as error:
+            findings.append(
+                AdvancedFinding(
+                    "OvalFoundationAccounting",
+                    f"The explicit oval foundation instruction is inconsistent: {error}",
+                    "error",
+                    line_number,
+                )
+            )
+            continue
+        findings.extend(
+            AdvancedFinding("OvalFoundationAccounting", message, "error", line_number)
+            for message in errors
+        )
+        if not errors:
+            return_chains = sum(
+                operation.chains_consumed
+                if isinstance(operation, ChainWork)
+                else operation[0]
+                for operation in return_ops
+            )
+            available_return = max(
+                int(count_match.group(1)) - int(start_match.group(1)),
+                0,
+            )
+            if return_chains < available_return:
+                findings.append(
+                    AdvancedFinding(
+                        "OvalReturnUnaccountedChains",
+                        f"The explicit oval return-side operations consume {return_chains} of {available_return} remaining chains. Confirm that any skipped foundation chains are intentional.",
+                        "warning",
+                        line_number,
+                    )
+                )
+    return findings
diff --git a/src/crochet_checker/validation/advanced_checks/spatial.py b/src/crochet_checker/validation/advanced_checks/spatial.py
new file mode 100644
index 0000000000000000000000000000000000000000..bf4504e9656817093096d51fbfa4725984d25c79
--- /dev/null
+++ b/src/crochet_checker/validation/advanced_checks/spatial.py
@@ -0,0 +1,500 @@
+"""Explicit 2D attachment boxes, stitch-to-angle mapping, and spiral warnings."""
+
+from __future__ import annotations
+
+import math
+import re
+from dataclasses import dataclass
+from typing import Mapping
+
+from .common import AdvancedFinding, ROUND_HEADER, STATED_COUNT, split_sections
+
+_FEATURE = re.compile(
+    r"\b(snout\s+bridge|safety\s+eyes?|eyes?|muzzle|ears?|horns?|tails?|"
+    r"fore\s+legs?|forelegs?|hind\s*legs?|arms?|legs?|wings?|shoulders?|neck\s+ruff|pelvis|limbs?)\b",
+    re.IGNORECASE,
+)
+_PARENT = re.compile(
+    r"\b(?:to|on|onto|in|into)\s+(?:the\s+)?(head|torso|body|face|chest|back)\b",
+    re.IGNORECASE,
+)
+_ROUND_RANGE = re.compile(
+    r"\b(?:rounds?|rnds?|r)\s*(\d+)\s*(?:[-–—]|to|through|and)\s*(?:r\s*)?(\d+)\b",
+    re.IGNORECASE,
+)
+_ROUND_SINGLE = re.compile(r"\b(?:round|rnd|r)\s*(\d+)\b", re.IGNORECASE)
+_STITCH_RANGE = re.compile(
+    r"\b(?:stitch(?:es)?|sts?|stitch\s+indices)\s*(\d+)\s*(?:[-–—]|to|through|and|&)\s*(\d+)\b",
+    re.IGNORECASE,
+)
+_STITCH_SINGLE = re.compile(r"\b(?:stitch(?:es)?|sts?)\s*(\d+)\b", re.IGNORECASE)
+_ANGLE_RANGE = re.compile(
+    r"\b(\d+(?:\.\d+)?)\s*(?:°|degrees?)\s*(?:[-–—]|to|through|and)\s*"
+    r"(\d+(?:\.\d+)?)\s*(?:°|degrees?)\b",
+    re.IGNORECASE,
+)
+_ANGLE_SINGLE = re.compile(r"\b(\d+(?:\.\d+)?)\s*(?:°|degrees?)\b", re.IGNORECASE)
+_PLACEMENT = re.compile(
+    r"\b(?:attach|sew|place|position|insert|mount|join|graft|embroider)\w*\b",
+    re.IGNORECASE,
+)
+
+
+@dataclass(frozen=True)
+class FeatureBounds:
+    feature: str
+    parent: str | None
+    round_min: int | None
+    round_max: int | None
+    horizontal_min: float | None
+    horizontal_max: float | None
+    horizontal_unit: str | None
+    source: str
+    line_number: int = 0
+
+
+def stitch_to_angle(stitch_index: int, stitch_count: int) -> float:
+    """Map a one-based stitch index to a clockwise-positive polar angle."""
+    if stitch_count <= 0 or stitch_index < 1 or stitch_index > stitch_count:
+        raise ValueError("Stitch index must be within a positive round stitch count.")
+    return ((stitch_index - 0.5) / stitch_count) * 360.0
+
+
+def boxes_overlap(a: FeatureBounds, b: FeatureBounds) -> bool:
+    """Return True only for complete, comparable boxes on the same parent."""
+    values = (
+        a.round_min,
+        a.round_max,
+        b.round_min,
+        b.round_max,
+        a.horizontal_min,
+        a.horizontal_max,
+        b.horizontal_min,
+        b.horizontal_max,
+    )
+    if any(value is None for value in values):
+        return False
+    if not a.parent or not b.parent or a.parent.casefold() != b.parent.casefold():
+        return False
+    if (
+        not a.horizontal_unit
+        or not b.horizontal_unit
+        or a.horizontal_unit.casefold() != b.horizontal_unit.casefold()
+    ):
+        return False
+    round_overlap = max(a.round_min, b.round_min) <= min(a.round_max, b.round_max)
+    horizontal_overlap = max(a.horizontal_min, b.horizontal_min) <= min(
+        a.horizontal_max, b.horizontal_max
+    )
+    return round_overlap and horizontal_overlap
+
+
+def find_spatial_collisions(features: list[FeatureBounds]) -> list[AdvancedFinding]:
+    findings: list[AdvancedFinding] = []
+    for index, first in enumerate(features):
+        for second in features[index + 1 :]:
+            if first.feature.casefold() == second.feature.casefold():
+                continue
+            if boxes_overlap(first, second):
+                unit = first.horizontal_unit or "coordinate"
+                findings.append(
+                    AdvancedFinding(
+                        "SpatialBoundingBoxCollision",
+                        f"{first.feature} and {second.feature} have overlapping explicit placement boxes on {first.parent} (rounds {first.round_min}–{first.round_max}, {unit} {first.horizontal_min:g}–{first.horizontal_max:g}). Verify the intended layout.",
+                        "warning",
+                        second.line_number,
+                    )
+                )
+    return findings
+
+
+def attachment_bounds_from_text(text: str) -> list[FeatureBounds]:
+    """Extract only explicit round and stitch/angle intervals from placement lines."""
+    found: list[FeatureBounds] = []
+    for line_number, raw in enumerate(text.splitlines(), start=1):
+        if not _PLACEMENT.search(raw):
+            continue
+        features = list(_FEATURE.finditer(raw))
+        if not features:
+            continue
+        parent_match = _PARENT.search(raw)
+        parent = parent_match.group(1) if parent_match else None
+        round_range = _ROUND_RANGE.search(raw)
+        if round_range:
+            first_round, last_round = (
+                int(round_range.group(1)),
+                int(round_range.group(2)),
+            )
+            if first_round <= last_round:
+                r0, r1 = first_round, last_round
+            else:
+                r0 = r1 = None
+        else:
+            round_single = _ROUND_SINGLE.search(raw)
+            r0 = r1 = int(round_single.group(1)) if round_single else None
+        stitch_range = _STITCH_RANGE.search(raw)
+        if stitch_range:
+            first_stitch, last_stitch = (
+                float(stitch_range.group(1)),
+                float(stitch_range.group(2)),
+            )
+            if first_stitch <= last_stitch:
+                h0, h1 = first_stitch, last_stitch
+                unit = "stitch"
+            else:
+                h0 = h1 = None
+                unit = None
+        else:
+            angle_range = _ANGLE_RANGE.search(raw)
+            if angle_range:
+                first, second = float(angle_range.group(1)), float(angle_range.group(2))
+                if first > second:
+                    h0 = h1 = None
+                    unit = None
+                elif re.search(
+                    r"\b(?:counterclockwise|counter-clockwise|anticlockwise|anti-clockwise)\b",
+                    raw,
+                    re.IGNORECASE,
+                ):
+                    h0, h1 = 360.0 - second, 360.0 - first
+                    unit = "degree"
+                else:
+                    h0, h1 = first, second
+                    unit = "degree"
+            else:
+                stitch_single = _STITCH_SINGLE.search(raw)
+                angle_single = _ANGLE_SINGLE.search(raw)
+                if stitch_single:
+                    h0 = h1 = float(stitch_single.group(1))
+                    unit = "stitch"
+                elif angle_single:
+                    angle = float(angle_single.group(1))
+                    if re.search(
+                        r"\b(?:counterclockwise|counter-clockwise|anticlockwise|anti-clockwise)\b",
+                        raw,
+                        re.IGNORECASE,
+                    ):
+                        angle = (-angle) % 360.0
+                    h0 = h1 = angle % 360.0
+                    unit = "degree"
+                else:
+                    h0 = h1 = None
+                    unit = None
+        for feature_match in features:
+            name = re.sub(r"\s+", " ", feature_match.group(1).lower())
+            if name.startswith("safety eye"):
+                name = "safety eyes"
+            elif name == "eye":
+                name = "eyes"
+            elif name == "ear":
+                name = "ears"
+            elif name == "horn":
+                name = "horns"
+            elif name in {"tail"}:
+                name = "tails"
+            found.append(
+                FeatureBounds(
+                    name, parent, r0, r1, h0, h1, unit, raw.strip(), line_number
+                )
+            )
+    return found
+
+
+def _gauge_cm(text: str) -> tuple[float, float] | None:
+    pattern = re.compile(
+        r"\b(?:gauge\s*:?\s*)?(\d+(?:\.\d+)?)\s*(?:sc\s*)?(?:sts?|stitches)\s*(?:and|[,/]?)\s*"
+        r"(\d+(?:\.\d+)?)\s*(?:rows?|rnds?)\s*(?:=|in)\s*"
+        r"(\d+(?:\.\d+)?)\s*(inches?|in|cm)\b",
+        re.IGNORECASE,
+    )
+    gauges: set[tuple[float, float]] = set()
+    for match in pattern.finditer(text):
+        unit_size = float(match.group(3))
+        unit = match.group(4).lower()
+        centimeters = unit_size * 2.54 if unit.startswith("in") else unit_size
+        if centimeters <= 0:
+            continue
+        gauges.add(
+            (
+                float(match.group(1)) / centimeters,
+                float(match.group(2)) / centimeters,
+            )
+        )
+    if len(gauges) != 1:
+        return None
+    return next(iter(gauges))
+
+
+def seam_stretch_mismatch(
+    seam_stitches: int,
+    body_rounds: int,
+    gauge_stitches_per_cm: float,
+    gauge_rounds_per_cm: float,
+    threshold: float = 1.5,
+) -> str | None:
+    """Compare explicit seam width and round span using an explicit gauge."""
+    if (
+        min(seam_stitches, body_rounds) < 0
+        or min(gauge_stitches_per_cm, gauge_rounds_per_cm) <= 0
+        or threshold <= 1
+    ):
+        return None
+    width_cm = seam_stitches / gauge_stitches_per_cm
+    height_cm = body_rounds / gauge_rounds_per_cm
+    small = min(width_cm, height_cm)
+    if small == 0 or max(width_cm, height_cm) <= threshold * small:
+        return None
+    return (
+        f"SeamStretchMismatch: explicit seam width {width_cm:.2f} cm and round span "
+        f"{height_cm:.2f} cm differ by more than {threshold:g}x. Verify the fit or gauge."
+    )
+
+
+def _circular_delta(a: float, b: float) -> float:
+    return abs((a - b + 180.0) % 360.0 - 180.0)
+
+
+def _pair_midpoint(a: float, b: float) -> float | None:
+    x = math.cos(math.radians(a)) + math.cos(math.radians(b))
+    y = math.sin(math.radians(a)) + math.sin(math.radians(b))
+    if math.hypot(x, y) < 1e-9:
+        return None
+    return math.degrees(math.atan2(y, x)) % 360.0
+
+
+def _minimal_arc(angles: list[float]) -> float:
+    ordered = sorted(angle % 360.0 for angle in angles)
+    if len(ordered) < 2:
+        return 0.0
+    gaps = [ordered[i + 1] - ordered[i] for i in range(len(ordered) - 1)]
+    gaps.append(ordered[0] + 360.0 - ordered[-1])
+    return 360.0 - max(gaps)
+
+
+def quadruped_compass_findings(
+    attachments: Mapping[str, tuple[int, int, int]],
+) -> list[AdvancedFinding]:
+    """Check explicit four-leg positions under a defined polar reference.
+
+    Mapping values are ``(round_number, one_based_stitch_index, round_stitch_count)``.
+    The calling contract is that stitch 1 is centered on the explicitly defined
+    front axis. Text input is checked only when it states that reference and
+    explicitly identifies the attachment as JAYG.
+    """
+    normalized = {key.casefold(): value for key, value in attachments.items()}
+    names = ("foreleg 1", "foreleg 2", "hind leg 1", "hind leg 2")
+    if not all(name in normalized for name in names):
+        return []
+    positions = [normalized[name] for name in names]
+    if any(not isinstance(item, (tuple, list)) or len(item) != 3 for item in positions):
+        return []
+    if any(
+        not all(
+            isinstance(value, int) and not isinstance(value, bool) for value in item
+        )
+        for item in positions
+    ):
+        return []
+    if any(item[0] < 1 for item in positions):
+        return []
+    if (
+        len({item[0] for item in positions}) != 1
+        or len({item[2] for item in positions}) != 1
+    ):
+        return []
+    try:
+        front_axis = stitch_to_angle(1, positions[0][2])
+        angles = {
+            name: (
+                stitch_to_angle(normalized[name][1], normalized[name][2]) - front_axis
+            )
+            % 360.0
+            for name in names
+        }
+    except (TypeError, ValueError):
+        return []
+    all_angles = list(angles.values())
+    findings: list[AdvancedFinding] = []
+    if _minimal_arc(all_angles) <= 210.0:
+        findings.append(
+            AdvancedFinding(
+                "QuadrupedHemisphereClustering",
+                "The four explicitly mapped limb positions fit within a 210° arc; review their spacing around the body.",
+                "warning",
+            )
+        )
+    fore_mid = _pair_midpoint(angles["foreleg 1"], angles["foreleg 2"])
+    hind_mid = _pair_midpoint(angles["hind leg 1"], angles["hind leg 2"])
+    if fore_mid is not None and _circular_delta(fore_mid, 0.0) > 75.0:
+        findings.append(
+            AdvancedFinding(
+                "QuadrupedForelimbHemisphere",
+                "The explicit foreleg-pair midpoint falls outside ±75° of the defined front axis.",
+                "warning",
+            )
+        )
+    if hind_mid is not None and _circular_delta(hind_mid, 180.0) > 75.0:
+        findings.append(
+            AdvancedFinding(
+                "QuadrupedHindlimbHemisphere",
+                "The explicit hind-leg-pair midpoint falls outside ±75° of the defined back axis.",
+                "warning",
+            )
+        )
+    if fore_mid is not None and hind_mid is not None:
+        separation = _circular_delta(fore_mid, hind_mid)
+        if abs(separation - 90.0) <= 15.0:
+            findings.append(
+                AdvancedFinding(
+                    "QuadrupedCompassCrossError",
+                    "The explicit fore- and hind-pair midpoints are approximately orthogonal; review the stated limb quadrants.",
+                    "warning",
+                )
+            )
+    return findings
+
+
+_JAYG_WORDING = re.compile(r"\b(?:JAYG|join\s+as\s+you\s+go)\b", re.IGNORECASE)
+_FRONT_STITCH_REFERENCE = re.compile(
+    r"\bstitch\s*1\b[^.\n]{0,35}\b(?:is\s+)?(?:at|centered\s+at|aligned\s+with|marks?)\s+"
+    r"(?:(?:the\s+)?(?:center|centre)\s+)?front(?:\s+axis)?\b|"
+    r"\b(?:front\s+axis|center\s+front|centre\s+front)\s+(?:is|aligns\s+with)\s+stitch\s*1\b",
+    re.IGNORECASE,
+)
+_QUADRUPED_POSITION = re.compile(
+    r"\b(?P<name>fore\s*leg\s*[12]|hind\s*leg\s*[12])\b"
+    r"[^.\n]{0,50}?\b(?:round|rnd)\s*(?P<round>\d+)\b"
+    r"[^.\n]{0,50}?\b(?:stitch|st)\s*(?P<stitch>\d+)\s+of\s+(?P<count>\d+)\b",
+    re.IGNORECASE,
+)
+
+
+def quadruped_findings_from_text(text: str) -> list[AdvancedFinding]:
+    """Check JAYG limb positions only with an explicit stitch-1/front reference."""
+    findings: list[AdvancedFinding] = []
+    for heading, body, _start_line in split_sections(text):
+        body_start = _start_line + (1 if heading else 0)
+        scope = f"{heading}\n{body}"
+        if not _JAYG_WORDING.search(scope) or not _FRONT_STITCH_REFERENCE.search(scope):
+            continue
+        positions: dict[str, tuple[int, int, int]] = {}
+        line_by_name: dict[str, int] = {}
+        for line_number, line in enumerate(body.splitlines(), start=body_start):
+            for match in _QUADRUPED_POSITION.finditer(line):
+                raw_name = re.sub(r"\s+", " ", match.group("name").lower())
+                digit = re.search(r"[12]", raw_name)
+                if not digit:
+                    continue
+                limb = "foreleg" if raw_name.startswith("fore") else "hind leg"
+                name = f"{limb} {digit.group(0)}"
+                positions[name] = (
+                    int(match.group("round")),
+                    int(match.group("stitch")),
+                    int(match.group("count")),
+                )
+                line_by_name[name] = line_number
+        section_findings = quadruped_compass_findings(positions)
+        line_number = min(line_by_name.values(), default=0)
+        findings.extend(
+            AdvancedFinding(item.code, item.message, item.severity, line_number)
+            for item in section_findings
+        )
+    return findings
+
+
+def _color_runs(body: str) -> tuple[tuple[int, str], ...]:
+    matches = list(re.finditer(r"\b(\d+)\s+([A-Z])\b", body))
+    if len(matches) < 3:
+        return ()
+    return tuple((int(m.group(1)), m.group(2)) for m in matches)
+
+
+def spiral_colorwork_findings(text: str) -> list[AdvancedFinding]:
+    """Warn only for four or more consecutive, identical explicit spiral color runs."""
+    findings: list[AdvancedFinding] = []
+    shift_every_round = re.compile(
+        r"\bjogless\b|\b(?:shift|offset|move\s+the\s+start)\b[^.\n]{0,80}"
+        r"\b(?:each|every|per)\s+round\b",
+        re.IGNORECASE,
+    )
+    for heading, body, start_line in split_sections(text):
+        body_start = start_line + (1 if heading else 0)
+        if not re.search(
+            r"\b(?:continuous\s+spiral|unjoined\s+spiral|worked\s+in\s+an?\s+unjoined\s+spiral)\b",
+            body,
+            re.IGNORECASE,
+        ):
+            continue
+        if shift_every_round.search(body):
+            continue
+        records = []
+        for local_index, line in enumerate(body.splitlines(), start=body_start):
+            header = ROUND_HEADER.match(line.strip())
+            if not header:
+                continue
+            signature = _color_runs(header.group(2))
+            stated_count = STATED_COUNT.search(header.group(2))
+            if (
+                signature
+                and stated_count
+                and sum(count for count, _color in signature)
+                == int(stated_count.group(1))
+                and signature[0][1] == signature[-1][1]
+            ):
+                records.append((int(header.group(1)), signature, local_index))
+        streak: list[tuple[int, tuple[tuple[int, str], ...], int]] = []
+        for record in records:
+            if streak and (
+                record[0] != streak[-1][0] + 1 or record[1] != streak[-1][1]
+            ):
+                if len(streak) >= 4:
+                    findings.append(_spiral_finding(streak))
+                streak = []
+            streak.append(record)
+        if len(streak) >= 4:
+            findings.append(_spiral_finding(streak))
+    return findings
+
+
+def _spiral_finding(streak):
+    start, end = streak[0][0], streak[-1][0]
+    return AdvancedFinding(
+        "SpiralColorworkDrift",
+        f"Rounds {start}–{end} repeat identical stitch-count color panels in a continuous unjoined spiral without an explicit shift. The panel may drift; consider a written offset or jog correction.",
+        "warning",
+        streak[0][2],
+    )
+
+
+_EXPLICIT_SEAM_SPAN = re.compile(
+    r"\b(?:seam|attachment\s+span)\s*[:=]\s*(\d+)\s*(?:sc\s*)?(?:sts?|stitches)\b"
+    r"[^.\n]{0,60}?\b(\d+)\s*(?:rounds?|rnds?|rows?)\b",
+    re.IGNORECASE,
+)
+
+
+def seam_stretch_findings(text: str) -> list[AdvancedFinding]:
+    gauge = _gauge_cm(text)
+    if gauge is None:
+        return []
+    findings = []
+    for line_number, line in enumerate(text.splitlines(), start=1):
+        match = _EXPLICIT_SEAM_SPAN.search(line)
+        if not match:
+            continue
+        message = seam_stretch_mismatch(
+            int(match.group(1)), int(match.group(2)), gauge[0], gauge[1]
+        )
+        if message:
+            findings.append(
+                AdvancedFinding("SeamStretchMismatch", message, "warning", line_number)
+            )
+    return findings
+
+
+def spatial_findings(text: str) -> list[AdvancedFinding]:
+    return (
+        find_spatial_collisions(attachment_bounds_from_text(text))
+        + seam_stretch_findings(text)
+        + spiral_colorwork_findings(text)
+    )
diff --git a/src/crochet_checker/validation/advanced_checks/turned_rows.py b/src/crochet_checker/validation/advanced_checks/turned_rows.py
new file mode 100644
index 0000000000000000000000000000000000000000..68408bb8e675dcaa1f073e68658f293b0b9cb048
--- /dev/null
+++ b/src/crochet_checker/validation/advanced_checks/turned_rows.py
@@ -0,0 +1,320 @@
+"""Turn, face parity, height-profile reversal, and WS-only stitch checks."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from .common import AdvancedFinding, ROUND_HEADER, ROW_HEADER, split_sections
+
+_HEIGHT = {"sl st": 0, "sc": 1, "hdc": 2, "dc": 3, "tr": 4, "dtr": 5}
+_REQUIRED_TURN_CHAIN = {"sc": 1, "hdc": 2, "dc": 3, "tr": 4, "dtr": 5}
+_ROW = re.compile(
+    r"^\s*row\.?\s*(\d+)\b\s*(?:\((RS|WS)\)|[, ]+\b(RS|WS)\b)?\s*[:.)-]?\s*(.*)$",
+    re.IGNORECASE,
+)
+_STITCH = re.compile(
+    r"(?:(?P<before>\d+)\s*(?:[x×]\s*)?)?"
+    r"(?P<stitch>dtr|tr|dc|hdc|sc|sl\s*st)\b"
+    r"(?:\s*[x×]?\s*(?P<after>\d+))?",
+    re.IGNORECASE,
+)
+_FACE = re.compile(r"\b(RS|WS|right\s+side|wrong\s+side)\b", re.IGNORECASE)
+
+
+@dataclass(frozen=True)
+class RowProfile:
+    number: int
+    source: str
+    body: str
+    explicit_face: str | None
+    heights: tuple[int, ...]
+    stitch_types: tuple[str, ...]
+    turn_at_start: bool
+    turn_at_end: bool
+    turning_chain: int | None
+    line_number: int
+
+
+@dataclass(frozen=True)
+class RowOrientation:
+    number: int
+    face: str | None
+    reverse_stitch_array: bool
+    traversal_reversed: bool
+
+
+def _is_positive_turn(body: str, match: re.Match[str]) -> bool:
+    before = body[max(0, match.start() - 20) : match.start()]
+    return not re.search(r"(?:do\s+not|don't|should\s+not)\s*$", before, re.IGNORECASE)
+
+
+def _profile(line: str, line_number: int) -> RowProfile | None:
+    match = _ROW.match(line.strip())
+    if not match:
+        return None
+    number = int(match.group(1))
+    explicit = (match.group(2) or match.group(3) or "").upper() or None
+    body = match.group(4)
+    if explicit is None:
+        side = _FACE.search(body)
+        if side:
+            token = side.group(1).upper()
+            explicit = "RS" if token == "RS" or token.startswith("RIGHT") else "WS"
+
+    tokens = list(_STITCH.finditer(body))
+    heights: list[int] = []
+    stitch_types: list[str] = []
+    token_counts = [
+        int(token.group("before") or token.group("after") or 1) for token in tokens
+    ]
+    if sum(token_counts) <= 10_000:
+        for token, count in zip(tokens, token_counts, strict=True):
+            name = re.sub(r"\s+", " ", token.group("stitch").lower())
+            heights.extend([_HEIGHT[name]] * count)
+            stitch_types.extend([name] * count)
+
+    turns = [
+        m
+        for m in re.finditer(r"\bturn\b", body, re.IGNORECASE)
+        if _is_positive_turn(body, m)
+    ]
+    first_start = tokens[0].start() if tokens else len(body)
+    last_end = tokens[-1].end() if tokens else 0
+    turn_at_start = any(item.start() < first_start for item in turns)
+    turn_at_end = any(item.start() > last_end for item in turns)
+
+    chain = None
+    for chain_match in re.finditer(r"\b(?:ch|chain)\s+(\d+)\b", body, re.IGNORECASE):
+        following_turn = re.search(
+            r"\bturn\b", body[chain_match.end() : chain_match.end() + 20], re.IGNORECASE
+        )
+        preceding_turn = re.search(
+            r"\bturn\b",
+            body[max(0, chain_match.start() - 20) : chain_match.start()],
+            re.IGNORECASE,
+        )
+        if following_turn or preceding_turn:
+            chain = int(chain_match.group(1))
+            break
+
+    return RowProfile(
+        number,
+        line.strip(),
+        body,
+        explicit,
+        tuple(heights),
+        tuple(stitch_types),
+        turn_at_start,
+        turn_at_end,
+        chain,
+        line_number,
+    )
+
+
+def annotate_row_turns(rows: list[RowProfile]) -> list[RowOrientation]:
+    """Infer only turn parity; an unknown starting face stays unknown."""
+    result: list[RowOrientation] = []
+    face: str | None = None
+    traversal_reversed = False
+    previous_number: int | None = None
+    pending_turn = False
+    for row in rows:
+        if previous_number is not None and row.number != previous_number + 1:
+            face = None
+            traversal_reversed = False
+            pending_turn = False
+        turn_before = pending_turn or row.turn_at_start
+        if turn_before:
+            traversal_reversed = not traversal_reversed
+            # A trailing turn was already applied to the face after the prior
+            # row. A leading turn is applied here only when no pending turn did it.
+            if row.turn_at_start and not pending_turn and face is not None:
+                face = "WS" if face == "RS" else "RS"
+        if row.explicit_face is not None:
+            face = row.explicit_face
+        result.append(
+            RowOrientation(
+                row.number,
+                face,
+                reverse_stitch_array=turn_before,
+                traversal_reversed=traversal_reversed,
+            )
+        )
+        if face is not None and row.turn_at_end:
+            face = "WS" if face == "RS" else "RS"
+        pending_turn = row.turn_at_end
+        previous_number = row.number
+    return result
+
+
+def _slope(values: tuple[int, ...]) -> int:
+    if len(values) < 2:
+        return 0
+    return (values[-1] > values[0]) - (values[-1] < values[0])
+
+
+def _row_groups(text: str) -> list[tuple[list[RowProfile], str, int, str]]:
+    result = []
+    for heading, body, start_line in split_sections(text):
+        rows = []
+        body_start = start_line + (1 if heading else 0)
+        for number, line in enumerate(body.splitlines(), start=body_start):
+            parsed = _profile(line, number)
+            if parsed:
+                rows.append(parsed)
+        if rows:
+            result.append((rows, body, start_line, heading))
+    return result
+
+
+def turned_row_findings(text: str) -> list[AdvancedFinding]:
+    findings: list[AdvancedFinding] = []
+    glossary_dec_flo = bool(
+        re.search(
+            r"\bdec\s*[-:]\s*[^\n]*(?:front[- ]loops?|\bFLO\b)[^\n]*(?:invisible\s+)?decrease",
+            text,
+            re.IGNORECASE,
+        )
+    )
+    glossary_bobble_push = bool(
+        re.search(
+            r"\b(?:bo|bobble)\s*[-:]\s*[^\n]*(?:push|pushed)\s+(?:the\s+)?bobble\s+toward\s+you",
+            text,
+            re.IGNORECASE,
+        )
+    )
+
+    for rows, body, _start_line, heading in _row_groups(text):
+        orientation = annotate_row_turns(rows)
+        for index, row in enumerate(rows):
+            if index and row.number == rows[index - 1].number + 1:
+                previous = rows[index - 1]
+                prev_state = orientation[index - 1]
+                state = orientation[index]
+                if (
+                    row.explicit_face
+                    and prev_state.face
+                    and (previous.turn_at_end or row.turn_at_start)
+                ):
+                    expected = (
+                        ("WS" if prev_state.face == "RS" else "RS")
+                        if state.reverse_stitch_array
+                        else prev_state.face
+                    )
+                    if row.explicit_face != expected:
+                        findings.append(
+                            AdvancedFinding(
+                                "RowFaceParityConflict",
+                                f"Row {row.number} is marked {row.explicit_face}, but the written turn sequence predicts {expected}.",
+                                "error",
+                                row.line_number,
+                            )
+                        )
+
+                if previous.turn_at_end or row.turn_at_start:
+                    under = tuple(reversed(previous.heights))
+                    if (
+                        len(under) == len(row.heights)
+                        and _slope(under) < 0
+                        and _slope(row.heights) > 0
+                        and len(under) >= 3
+                    ):
+                        findings.append(
+                            AdvancedFinding(
+                                "TurnedRowTaperInversion",
+                                f"Row {row.number} reverses a rising stitch-height profile; its written profile also rises, so short stitches would stack over taller stitches. Review the taper direction.",
+                                "warning",
+                                row.line_number,
+                            )
+                        )
+
+                if (
+                    previous.turn_at_end
+                    and previous.turning_chain is not None
+                    and row.stitch_types
+                ):
+                    required = _REQUIRED_TURN_CHAIN.get(row.stitch_types[0])
+                    if required is not None and previous.turning_chain < required:
+                        findings.append(
+                            AdvancedFinding(
+                                "TurningChainHeightMismatch",
+                                f"Row {previous.number} turns with ch {previous.turning_chain}, but Row {row.number} begins with {row.stitch_types[0]} (commonly ch {required} is used for that height).",
+                                "warning",
+                                previous.line_number,
+                            )
+                        )
+
+            state = orientation[index]
+            if (
+                state.face == "WS"
+                and glossary_dec_flo
+                and re.search(r"\bdec\b", row.body, re.IGNORECASE)
+            ):
+                findings.append(
+                    AdvancedFinding(
+                        "WrongSideInvisibleDecrease",
+                        f"Row {row.number} is WS and uses a glossary-defined front-loop invisible decrease; consider a both-loop decrease or verify the intended visible side.",
+                        "warning",
+                        row.line_number,
+                    )
+                )
+            if (
+                state.face == "WS"
+                and glossary_bobble_push
+                and re.search(r"\b(?:bo|bobble)\b", row.body, re.IGNORECASE)
+            ):
+                findings.append(
+                    AdvancedFinding(
+                        "WrongSideBobbleExtrusion",
+                        f"Row {row.number} is WS and uses a bobble definition that pushes the bobble toward the worker; verify which fabric face should show it.",
+                        "warning",
+                        row.line_number,
+                    )
+                )
+
+        if re.search(r"\bshort[- ]rows?\b", f"{heading}\n{body}", re.IGNORECASE):
+            last = rows[-1]
+            last_face = orientation[-1].face
+            face_after = (
+                ("WS" if last_face == "RS" else "RS") if last.turn_at_end else last_face
+            )
+            body_lines = body.splitlines()
+            row_positions = [
+                index
+                for index, line in enumerate(body_lines)
+                if _ROW.match(line.strip())
+            ]
+            last_row_position = (
+                row_positions[-1] if row_positions else len(body_lines) - 1
+            )
+            resume_index = next(
+                (
+                    index
+                    for index, line in enumerate(
+                        body_lines[last_row_position + 1 :], start=last_row_position + 1
+                    )
+                    if ROUND_HEADER.match(line.strip())
+                ),
+                None,
+            )
+            reorientation = False
+            if resume_index is not None:
+                between = "\n".join(body_lines[last_row_position + 1 : resume_index])
+                reorientation = bool(
+                    re.search(
+                        r"\b(?:reorient\w*|flip(?:ped|ping)?|turn\s+(?:the\s+)?work|turn\s+to\s+(?:RS|right\s+side)|right[- ]side[- ]out)\b",
+                        between,
+                        re.IGNORECASE,
+                    )
+                )
+            if face_after == "WS" and resume_index is not None and not reorientation:
+                findings.append(
+                    AdvancedFinding(
+                        "InsideOutTopologyInversion",
+                        "Short rows leave the WS facing before continuous rounds resume. State an explicit reorientation or turn before continuing in the round.",
+                        "warning",
+                        last.line_number,
+                    )
+                )
+    return findings
